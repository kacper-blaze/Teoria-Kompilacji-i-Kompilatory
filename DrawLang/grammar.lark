// =====================================================================
// DrawLang grammar (Lark, Earley parser)
// =====================================================================

?start: program

program: statement*

// ---------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------

?statement: var_decl
          | assign_stmt
          | if_stmt
          | while_stmt
          | for_stmt
          | repeat_stmt
          | proc_decl
          | return_stmt
          | break_stmt
          | continue_stmt
          | shape_stmt
          | call_stmt

block: "{" statement* "}"

// --- variables --------------------------------------------------------
var_decl:    _LET IDENTIFIER "=" expr
assign_stmt: IDENTIFIER "=" expr

// --- control flow -----------------------------------------------------
if_stmt:     _IF expr block (_ELSE (if_stmt | block))?

while_stmt:  _WHILE expr block

for_stmt:    _FOR IDENTIFIER "=" expr _TO expr (_STEP expr)? block

repeat_stmt: _REPEAT expr block

break_stmt:    _BREAK
continue_stmt: _CONTINUE

// --- procedures -------------------------------------------------------
proc_decl:   _PROC IDENTIFIER "(" params? ")" block
params:      IDENTIFIER ("," IDENTIFIER)*

return_stmt: _RETURN [expr]

call_stmt:   IDENTIFIER "(" args? ")"
args:        expr ("," expr)*

// ---------------------------------------------------------------------
// Built-in shape / setting statements
// ---------------------------------------------------------------------

?shape_stmt: canvas_stmt
           | circle_stmt
           | line_stmt
           | rect_stmt
           | color_stmt
           | translate_stmt
           | scale_stmt

canvas_stmt:    _CANVAS    expr expr
circle_stmt:    _CIRCLE    expr expr expr
line_stmt:      _LINE      expr expr expr expr
rect_stmt:      _RECT      expr expr expr expr

color_stmt:     _COLOR color_value
color_value:    HEX_COLOR | STRING | IDENTIFIER

translate_stmt: _TRANSLATE expr expr
scale_stmt:     _SCALE     expr

// ---------------------------------------------------------------------
// Expressions (logic and arithmetic)
// ---------------------------------------------------------------------

?expr:       logical_expr

// --- Logic exressions ------------------------------------------------
?logical_expr: or_expr
?or_expr:     and_expr (_OR and_expr)*
?and_expr:    not_expr (_AND not_expr)*
?not_expr:    _NOT not_expr -> not_op
             | logical_comparison
?logical_comparison: arithmetic_expr (cmp_op arithmetic_expr)?
!cmp_op:      "==" | "!=" | "<=" | ">=" | "<" | ">"

// --- Arithmetic expressions ---------------------------------------------
?arithmetic_expr: sum
?sum:         product (add_op product)*
!add_op:      "+" | "-"
?product:     unary (mul_op unary)*
!mul_op:      "*" | "/" | "%"
?unary:       "-" unary -> neg
             | arithmetic_atom

?arithmetic_atom: NUMBER -> number
                 | IDENTIFIER "(" args? ")" -> call
                 | IDENTIFIER -> var
                 | "(" arithmetic_expr ")"

// --- common atoms ------------------------------------------------------
?atom: NUMBER -> number
     | STRING -> string
     | bool_lit
     | IDENTIFIER "(" args? ")" -> call
     | IDENTIFIER -> var
     | "(" expr ")"

bool_lit: _TRUE | _FALSE

// ---------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------

_CANVAS:    "canvas"
_CIRCLE:    "circle"
_LINE:      "line"
_RECT:      "rect"
_COLOR:     "color"
_TRANSLATE: "translate"
_SCALE:     "scale"

_LET:       "let"
_IF:        "if"
_ELSE:      "else"
_WHILE:     "while"
_FOR:       "for"
_TO:        "to"
_STEP:      "step"
_REPEAT:    "repeat"
_PROC:      "proc"
_RETURN:    "return"
_BREAK:     "break"
_CONTINUE:  "continue"

_OR:        "or"
_AND:       "and"
_NOT:       "not"

_TRUE:      "true"
_FALSE:     "false"

HEX_COLOR: /#[0-9a-fA-F]{6}/

%import common.NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.CNAME -> IDENTIFIER
%import common.WS
%import common.CPP_COMMENT
%import common.C_COMMENT

%ignore WS
%ignore CPP_COMMENT
%ignore C_COMMENT
